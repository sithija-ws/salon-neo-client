// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum productStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model user {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  createdDate  DateTime  @default(now())
  lastLogin    DateTime?
  status       String    @default("ACTIVE") //BANNED, SUSPENDED
  phoneNumber  String?
  email        String    @unique
  password     String
  privilages   String[]  @default([])
  role         String    @default("CUSTOMER")
  profileImage String    @default("C:/Users/E-TEC/Desktop/PROJECTS/salon-neo/app/favicon.ico")
}

model Product {
  id          String        @id @default(uuid())
  sku         String        @unique
  brand       String?
  name        String?
  altNames    String[]      @default([])
  model       String
  description String
  stock       Int           @default(0)
  status      productStatus @default(ACTIVE)
  price       Float
  compareAt   Float?
  media Media[]
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id   String    @id @default(uuid())
  url  String
  type MediaType
  productId String
  product Product @relation(fields: [productId],references: [id])
}
